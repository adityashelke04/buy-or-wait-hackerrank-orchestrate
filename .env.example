# Optional. The default run needs no .env at all: python code/main.py
# Copy to .env only to try the cloud evidence reader. .env is gitignored and is
# never packaged into code.zip.

# rule  = local message parser + OCR (default, no key, no network)
# cloud = OpenAI-compatible endpoint; Google AI Studio by default
LLM_BACKEND=rule

# Only read when LLM_BACKEND=cloud (or --backend cloud)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_CLOUD_MODEL=gemini-2.0-flash
LLM_API_KEY=
